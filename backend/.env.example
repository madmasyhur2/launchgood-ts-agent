# =============================================================================
# LaunchGood T&S Agent — Backend Environment Variables (Template)
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- App ---
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=changeme-use-a-long-random-string-in-production

# --- PostgreSQL ---
# Used by docker-compose (at project root) and by the FastAPI app
POSTGRES_USER=launchgood
POSTGRES_PASSWORD=launchgood_secret
POSTGRES_DB=launchgood_ts
# Full async DSN — must use asyncpg driver
DATABASE_URL=postgresql+asyncpg://launchgood:launchgood_secret@localhost:5432/launchgood_ts

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Google Gemini (LLM) ---
# Required for AI agent content analysis and decision reasoning
GOOGLE_API_KEY=your-google-api-key-here

# Model configuration (override defaults from config.py if needed)
# GEMINI_FLASH_MODEL=gemini-2.0-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro-preview-06-05

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Celery (Async Worker) ---
# Same as REDIS_URL — Celery uses Redis as its broker and result backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- API ---
# Base path prefix for all API routes
API_PREFIX=/api

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
