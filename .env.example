# =============================================================================
# LaunchGood T&S Agent — Project Environment Guide
# =============================================================================
#
# This is a monorepo with two services. Each has its own env file:
#
#   backend/.env          ← Backend (FastAPI) secrets — copy from backend/.env.example
#   frontend/.env.local   ← Frontend (Next.js) config — copy from frontend/.env.local.example
#
# Infrastructure (PostgreSQL, Redis) is configured via docker-compose.yml at
# this root directory. The Postgres credentials used here must match DATABASE_URL
# in backend/.env.
#
# =============================================================================

# --- Docker Compose (infrastructure only) ---
# These variables are read by docker-compose.yml to provision PostgreSQL.
# They must match the DATABASE_URL in backend/.env.

POSTGRES_USER=launchgood
POSTGRES_PASSWORD=launchgood_secret
POSTGRES_DB=launchgood_ts
